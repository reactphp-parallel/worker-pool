{
    "name": "react-parallel/worker-pool",
    "description": "\ud83d\udc77\ud83d\udc77\u200d\u2640\ufe0f\ud83d\udc77\u200d\u2642\ufe0f Worker pool for only one specific designated task",
    "license": "MIT",
    "authors": [
        {
            "name": "Cees-Jan Kiewiet",
            "email": "ceesjank@gmail.com",
            "homepage": "http://wyrihaximus.net/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-parallel": "^1.2",
        "react-parallel/contracts": "^2@dev",
        "react-parallel/event-loop": "^2@dev",
        "react-parallel/react-parallel": "^2@dev",
        "react/event-loop": "^1.1",
        "react/promise": "^3.2",
        "wyrihaximus/constants": "^1.5",
        "wyrihaximus/json-throwable": "^4.0",
        "wyrihaximus/pool-info": "^2.0"
    },
    "require-dev": {
        "money/money": "^2.0",
        "moneyphp/money": "^3.2.1",
        "react-parallel/infinite-pool": "^3@dev",
        "react-parallel/pool-tests": "^4@dev",
        "wyrihaximus/async-test-utilities": "^7.3.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ReactParallel\\Pool\\Worker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReactParallel\\Tests\\Pool\\Worker\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "icanhazstring/composer-unused": true,
            "infection/extension-installer": true,
            "ocramius/package-versions": true
        },
        "platform": {
            "php": "8.2.13"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "composer normalize"
        ],
        "post-update-cmd": [
            "composer normalize"
        ]
    }
}
